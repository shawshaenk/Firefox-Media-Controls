{
  "name": "firefox-media-controller",
  "version": "1.0.2",
  "description": "Chrome Media Controls for Firefox",
  "scripts": {
    "package": "python3 scripts/generate-icons.py && npm run build && python3 scripts/package.py",
    "package:source": "python3 scripts/package-source.py",
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "web-ext lint"
  },
  "keywords": [
    "firefox",
    "extension",
    "media-controls",
    "webextension"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0"
  }
}
